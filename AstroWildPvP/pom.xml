<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.astropvp</groupId>
    <artifactId>AstroWildPvP</artifactId>
    <version>0.1</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>AstroWildPvP</finalName>
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>me.mc2.internal.hikari</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- Aikar's official repository, source of acf-paper 0.5.0-SNAPSHOT -->
        <repository>
            <id>aikar</id>
            <url>https://repo.aikar.co/content/groups/aikar/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>ess-repo</id>
            <url>https://repo.essentialsx.net/releases/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>winespigot</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/WineSpigot-V1.1.6.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>coere</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/AstroCore.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>ark</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Arkkit.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>factions</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Factions.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>skyitems</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/CosmicSkyCustomItems.jar</systemPath>
        </dependency>



        <dependency>
            <groupId>fr.minuskube.inv</groupId>
            <artifactId>smart-invs</artifactId>
            <version>1.2.7</version>
            <exclusions>
                <!-- Pulled in via spigot-api 1.8.8; no longer downloadable. The same version
                     (bungeecord-chat 1.8-SNAPSHOT) is bundled in the WineSpigot server jar. -->
                <exclusion>
                    <groupId>net.md-5</groupId>
                    <artifactId>bungeecord-chat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>pets</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/CosmicSkyInventoryPets.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>eapi</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/EnchantmentsAPI.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>skins</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/ItemSkins-0.1.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>articleapi</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/ParticleAPI_v2.1.1.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>enchants</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Enchantments.jar</systemPath>
        </dependency>



        <dependency>
            <groupId>com.astropvp</groupId>
            <artifactId>weaponrunes</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/WeaponRunes.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>server</artifactId>
            <version>1.8.8-R0.2-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>




        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.16.18</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>CosmicPvPUtils</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../Utils/target/CosmicPvPUtils.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>co.aikar</groupId>
            <artifactId>acf-paper</artifactId>
            <version>0.5.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>


    </dependencies>

</project>
