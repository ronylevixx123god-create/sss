<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.conaxgames</groupId>
    <artifactId>CosmicShop</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>



    <build>
        <defaultGoal>clean install</defaultGoal>
        <finalName>CosmicShop</finalName>

    </build>

    <repositories>
        <repository>
            <id>ess-repo</id>
            <url>https://ci.ender.zone/plugin/repository/everything/</url>
        </repository>

        <repository>
            <id>paper-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>


    <dependencies>
        <!-- ConaxGames repos -->
        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>server</artifactId>
            <version>1.8.8-R0.2-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- System repos -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>items</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/CosmicSkyCustomItems.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>core</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/AstroCore.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>col</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/AstroCollectors-1.0-SNAPSHOT.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>ess</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Essentials.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local.com.conaxgames</groupId>
            <artifactId>Arkkit</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Arkkit.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>CosmicPvPUtils</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../Utils/target/CosmicPvPUtils.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>CompilexPermissions</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/CompilexPermissions_2_1_1_1.jar</systemPath>
        </dependency>



        <dependency>
            <groupId>com.conaxgames</groupId>
            <artifactId>Spawners</artifactId>
            <version>0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/AstroSpawners.jar</systemPath>
        </dependency>

    </dependencies>


</project>
